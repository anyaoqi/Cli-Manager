<ui:FluentWindow x:Class="CliManager.App.Views.ImportToolsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="导入检测到的 CLI 工具 - CliManager"
                 Icon="pack://application:,,,/CliManager.App;component/Assets/logo.png"
                 Width="720" Height="640"
                 MinWidth="600" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="导入检测到的 CLI 工具 - CliManager">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/CliManager.App;component/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <!-- 0: 说明 -->
                <RowDefinition Height="Auto" />
                <!-- 1: 勾选工具栏 -->
                <RowDefinition Height="Auto" />
                <!-- 2: 候选工具列表 -->
                <RowDefinition Height="*" />
                <!-- 3: 导入位置 -->
                <RowDefinition Height="Auto" />
                <!-- 4: 底部按钮 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 说明 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="📥 扫描并导入 CLI 工具" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="已在本机发现以下 CLI 工具（含 Node.js 目录中的全部命令），请勾选需要导入的项，并选择要放入的分组："
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 勾选工具栏 -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="10,4" />
                    <ui:Button Content="全不选" Command="{Binding UnselectAllCommand}" Margin="0,0,6,0" Padding="10,4" />
                    <ui:Button Content="仅选 AI 工具" Command="{Binding SelectAiOnlyCommand}" Padding="10,4"
                               ToolTip="仅勾选已识别的 AI CLI 预设工具（如 Claude、OpenCode、Codex 等）"
                               ToolTipService.InitialShowDelay="200" />
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="已选 " /><Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" / " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 个工具" />
                </TextBlock>
            </Grid>

            <!-- 候选工具列表 -->
            <Border Grid.Row="2" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ui:ListView ItemsSource="{Binding Tools}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding ExecutablePath}" />
                                    <Border VerticalAlignment="Center" Margin="6,0,0,0"
                                            CornerRadius="4" Padding="5,1"
                                            Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                            Visibility="{Binding IsAiTool, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="🤖 AI CLI" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                        CornerRadius="8" Padding="7,1"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding ExecutablePath}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </Border>

            <!-- 导入位置 -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="导入位置" FontWeight="Medium" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding FolderOptions}"
                              SelectedItem="{Binding SelectedFolder}"
                              DisplayMemberPath="DisplayName" />
                    <ui:TextBox Grid.Column="2" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入新分组名称，如：AI 编程工具"
                                Visibility="{Binding IsNewFolderSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
                <TextBlock Text="提示：不选择分组时，工具将直接导入到根层级（一级菜单直出）。"
                           FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="取消" Width="90" Margin="0,0,10,0" Click="OnCancelClicked" IsCancel="True" />
                <ui:Button Content="导入" Width="110" Appearance="Primary" IsDefault="True"
                           Command="{Binding ImportCommand}" Click="OnImportClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
