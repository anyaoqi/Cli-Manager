<ui:FluentWindow x:Class="CliManager.App.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CliManager.App.ViewModels"
                 Title="CliManager - 开发终端右键管理工具"
                 Icon="pack://application:,,,/CliManager.App;component/Assets/logo.png"
                 Width="1120" Height="740"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: 标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 顶部检测横幅 -->
            <RowDefinition Height="Auto" />
            <!-- 2: 主工作区（左侧树 + 右侧编辑卡片） -->
            <RowDefinition Height="*" />
            <!-- 3: 底部实时预览与动作栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏（展示应用 Logo） -->
        <ui:TitleBar Grid.Row="0" Title="CliManager - 开发终端右键管理工具">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/CliManager.App;component/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 顶部自动检测横幅 -->
        <Border Grid.Row="1" Margin="16,0,16,12" Padding="12,10"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource AccentStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasDetectedTools, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DetectedBannerText}" VerticalAlignment="Center" FontWeight="Medium" />
                <ui:Button Grid.Column="1" Content="📥 扫描并导入" Appearance="Primary"
                           Command="{Binding ImportDetectedToolsCommand}"
                           ToolTip="勾选要导入的 CLI 工具，并选择放入已有分组、新建分组或根层级"
                           ToolTipService.InitialShowDelay="200" />
            </Grid>
        </Border>

        <!-- 操作结果浮动通知条 InfoBar -->
        <ui:InfoBar Grid.Row="2"
                    Title="{Binding InfoBarTitle}"
                    Message="{Binding InfoBarMessage}"
                    Severity="{Binding InfoBarSeverity}"
                    IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                    IsClosable="True"
                    VerticalAlignment="Top"
                    Panel.ZIndex="999"
                    Margin="16,8,16,0" />

        <!-- 主工作区分栏 -->
        <Grid Grid.Row="2" Margin="16,0,16,0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <!-- 左栏：结构编排与树形列表 -->
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500" />
                <!-- 拖拽分割条 -->
                <ColumnDefinition Width="8" />
                <!-- 右栏：属性配置 Inspector -->
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <ui:Card Grid.Column="0" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题与单行紧凑图标工具栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📂 菜单结构编排" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button ToolTip="新建文件夹" Command="{Binding AddFolderCommand}"
                                       ToolTipService.InitialShowDelay="200" Margin="0,0,4,0" Padding="6,5">
                                <ui:SymbolIcon Symbol="FolderAdd20" />
                            </ui:Button>
                            <ui:Button ToolTip="添加 CLI 工具" Command="{Binding AddToolCommand}"
                                       ToolTipService.InitialShowDelay="200" Margin="0,0,4,0" Padding="6,5">
                                <ui:SymbolIcon Symbol="Add20" />
                            </ui:Button>
                            <ui:Button ToolTip="上移" Command="{Binding MoveUpCommand}"
                                       ToolTipService.InitialShowDelay="200" Margin="0,0,4,0" Padding="6,5">
                                <ui:SymbolIcon Symbol="ArrowUp20" />
                            </ui:Button>
                            <ui:Button ToolTip="下移" Command="{Binding MoveDownCommand}"
                                       ToolTipService.InitialShowDelay="200" Padding="6,5">
                                <ui:SymbolIcon Symbol="ArrowDown20" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- 树形列表（支持拖拽）与空状态提示 -->
                    <Grid Grid.Row="1">
                        <TreeView x:Name="MenuTree"
                                  ItemsSource="{Binding RootNodes}"
                                  SelectedItemChanged="OnTreeSelectedItemChanged"
                                  PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                                  MouseMove="OnTreeMouseMove"
                                  DragOver="OnTreeDragOver"
                                  DragLeave="OnTreeDragLeave"
                                  Drop="OnTreeDrop"
                                  KeyDown="OnTreeKeyDown"
                                  AllowDrop="True"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <Border CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Padding" Value="6,5" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Margin" Value="0,3,0,2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                        <Setter Property="Margin" Value="2,1,0,1" />
                                                        <Setter Property="Padding" Value="4,4" />
                                                    </DataTrigger>
                                                    <!-- 拖拽中：源行半透明 -->
                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                    <!-- 悬停文件夹：作为"移入"投递目标高亮 -->
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DropTargetFillBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <!-- 行内容 -->
                                            <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <!-- 0: 树枝连接符 (仅子项显示) -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 1: 图标 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 2: 启用勾选框 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 3: 标题 -->
                                                <ColumnDefinition Width="*" />
                                                <!-- 4: 拖拽把手与数量角标 -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 树枝分支连接符 └─ -->
                                            <TextBlock Grid.Column="0" Text="└─ "
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsChild, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- 图标 -->
                                            <Image Grid.Column="1" Source="{Binding IconSource}" Width="18" Height="18" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- 启用勾选框 -->
                                            <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Margin="0,0,6,0" VerticalAlignment="Center" />

                                            <!-- 标题 -->
                                            <TextBlock Grid.Column="3" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="FontSize" Value="13.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 拖拽把手与数量角标 -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10" Padding="6,1" Margin="0,0,6,0"
                                                        Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Children.Count, StringFormat='{}{0} 项'}"
                                                               FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                                </Border>
                                                <TextBlock Text="≡" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Cursor="SizeAll" />
                                            </StackPanel>
                                            </Grid>

                                            <!-- 插入位置指示线：插入到本行上方 -->
                                            <Border Height="3" CornerRadius="1.5"
                                                    VerticalAlignment="Top" Margin="-6,-6,-6,0"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDropAbove}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 插入位置指示线：插入到本行下方 -->
                                            <Border Height="3" CornerRadius="1.5"
                                                    VerticalAlignment="Bottom" Margin="-6,0,-6,-6"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDropBelow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 行背景（悬停/选中高亮），横跨展开开关与内容 -->
                                                    <Border x:Name="Border" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                            CornerRadius="4" Background="Transparent" SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <!-- 选中态左侧指示条 -->
                                                            <Rectangle x:Name="ActiveRectangle" Width="3" Height="16" RadiusX="2" RadiusY="2"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                       Margin="1,0,0,0" Visibility="Collapsed"
                                                                       Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}" />

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- 折叠开关列：叶子节点折叠为 0 宽 -->
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 折叠开关：仅文件夹（HasItems）显示 -->
                                                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                              ClickMode="Press" Focusable="False" Cursor="Hand"
                                                                              VerticalAlignment="Center" Margin="2,0,2,0"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                              Visibility="Collapsed">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <ContentPresenter />
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <ui:SymbolIcon Symbol="ChevronRight12" FontSize="10"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </ToggleButton>

                                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  Margin="{TemplateBinding Padding}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="HasItems" Value="True">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Expander" Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}" />
                                                        <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <!-- 空状态引导提示 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                    Visibility="{Binding HasRootNodes, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="暂无菜单项" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="点击上方【➕ 新建文件夹】或【➕ 添加工具】开始编排，也可直接点击顶部横幅扫描并导入本地发现的 CLI 工具"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- 拖拽分割条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- 右栏：详情配置 Inspector -->
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <!-- 空白未选择提示 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedNode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="👈 请在左侧列表中选择一个文件夹或 CLI 工具进行配置"
                                   FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 文件夹属性编辑 -->
                    <Grid Visibility="{Binding IsEditingFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部标题与右上角删除按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📂 菜单文件夹配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Appearance="Danger"
                                       Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteCurrentCommand}"
                                       ToolTip="删除所选文件夹" ToolTipService.InitialShowDelay="200" Padding="10,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete20" Margin="0,0,6,0" />
                                    <TextBlock Text="删除" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding FolderEditor}">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="显示名称 (MUIVerb)" FontWeight="Medium" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="专属图标路径" FontWeight="Medium" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseIconCommand}" Margin="0,0,6,0" />
                                        <ui:Button Grid.Column="3" Content="清除" Command="{Binding ClearIconCommand}" />
                                    </Grid>
                                </StackPanel>

                                <CheckBox Content="在右键菜单中启用该文件夹" IsChecked="{Binding Enabled}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 工具属性编辑 -->
                    <Grid Visibility="{Binding IsEditingTool, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部标题与右上角删除按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📝 CLI 工具属性配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Appearance="Danger"
                                       Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteCurrentCommand}"
                                       ToolTip="删除此 CLI 工具" ToolTipService.InitialShowDelay="200" Padding="10,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete20" Margin="0,0,6,0" />
                                    <TextBlock Text="删除" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding ToolEditor}">

                            <!-- 提示/校验信息 -->
                            <TextBlock Text="{Binding ValidationMessage}" FontWeight="Medium" Margin="0,0,0,10"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                            <!-- 名称与归属 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="显示名称 (MUIVerb)" FontWeight="Medium" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="归属文件夹" FontWeight="Medium" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding FolderOptions}"
                                              SelectedItem="{Binding SelectedFolder}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Grid>

                            <!-- 可执行文件 -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="可执行程序路径 (.exe / .cmd / .bat / .ps1)" FontWeight="Medium" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseExecutableCommand}" />
                                </Grid>
                            </StackPanel>

                            <!-- 终端宿主与行为 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="终端宿主" FontWeight="Medium" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding HostOptions}" SelectedItem="{Binding Host}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,22,0,0">
                                    <CheckBox Content="命令退出后保留终端窗口" IsChecked="{Binding KeepOpen}" />
                                </StackPanel>
                            </Grid>

                            <!-- 附加参数 -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="附加启动参数（按空格分隔）" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:TextBox Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="例如：--dangerously-skip-permissions --verbose" />
                            </StackPanel>

                            <!-- 自定义模板（如果选 custom） -->
                            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsCustomHost, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="自定义启动模板（支持占位符 %V、%EXE%、%ARGS%）" FontWeight="Medium" Margin="0,0,0,6" />
                                <TextBox Text="{Binding CustomTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- 图标 -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="图标路径（支持 .ico / .exe / .png / 网站地址）" FontWeight="Medium" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             ToolTip="可直接填写网站地址（如 https://claude.ai），点击【获取图标】自动下载 favicon" />
                                    <ui:Button Grid.Column="2" Command="{Binding FetchWebsiteIconCommand}" Margin="0,0,6,0"
                                               IsEnabled="{Binding IsFetchingIcon, Converter={StaticResource InverseBoolConverter}}"
                                               ToolTip="从网站地址抓取 favicon 图标" ToolTipService.InitialShowDelay="200">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Globe20" Margin="0,0,4,0" />
                                            <TextBlock Text="获取图标" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="3" Content="浏览..." Command="{Binding BrowseIconCommand}" Margin="0,0,6,0" />
                                    <ui:Button Grid.Column="4" Content="清除" Command="{Binding ClearIconCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding IconHintMessage}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IconHintMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                                <TextBlock Text="{Binding IconStatusMessage}" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding IconStatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- 环境变量列表 -->
                            <StackPanel Margin="0,0,0,14">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="注入环境变量（如 HTTP_PROXY）" FontWeight="Medium" VerticalAlignment="Center" />
                                    <ui:Button Content="➕ 添加变量" HorizontalAlignment="Right" Command="{Binding AddEnvVarCommand}" />
                                </Grid>

                                <ui:ListView ItemsSource="{Binding EnvList}" Margin="0,4,0,0">
                                    <ui:ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="KEY" />
                                                <ui:TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="VALUE" />
                                                <ui:Button Grid.Column="3" Content="✕" Margin="6,0,0,0"
                                                           Command="{Binding DataContext.ToolEditor.RemoveEnvVarCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ui:ListView.ItemTemplate>
                                </ui:ListView>
                            </StackPanel>

                            <!-- 编译命令预览 -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="命令实时编译预览（写入注册表的值）" FontWeight="Medium" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBox Text="{Binding CompiledPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         Background="{DynamicResource ControlFillColorSecondaryBrush}" FontFamily="Consolas, Cascadia Code, Courier New" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ui:Card>
        </Grid>

        <!-- 底部实时预览与动作栏 -->
        <Grid Grid.Row="3" Margin="16,10,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 实时概览卡片 -->
            <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="12,8"
                     ToolTip="{Binding LivePreviewToolTip}" ToolTipService.InitialShowDelay="200">
                <TextBlock Text="{Binding LivePreviewText}" FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </ui:Card>

            <!-- 动作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="⚙️ 设置与迁移" Click="OnOpenSettingsClicked" Margin="0,0,10,0" />
                <ui:Button Content="💾 保存并同步到右键菜单" Appearance="Primary" Command="{Binding SaveAndSyncCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
