<ui:FluentWindow
    x:Class="RightMenu.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RightMenu.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="右键菜单管理"
    Icon="pack://application:,,,/Assets/app.png"
    Width="1040"
    Height="720"
    MinWidth="880"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="右键菜单管理">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 工具栏（规划 03 §1） -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontSize="13"
                Text="{Binding LocationName}" />

            <ui:TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                MaxWidth="360"
                HorizontalAlignment="Left"
                FontSize="13"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="搜索名称或命令"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="2"
                Margin="8,0,0,0"
                MinWidth="96"
                FontSize="13"
                SelectedIndex="{Binding FilterIndex}"
                AutomationProperties.Name="筛选">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="受管" />
                <ComboBoxItem Content="现有" />
                <ComboBoxItem Content="只读" />
            </ComboBox>

            <ui:Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Appearance="Primary"
                Command="{Binding AddCliCommand}"
                Content="添加 CLI"
                AutomationProperties.Name="添加 CLI" />

            <ui:Button
                Grid.Column="4"
                Margin="8,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="刷新"
                AutomationProperties.Name="刷新列表" />
        </Grid>

        <!-- 主列表 + Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="VerbList"
                Grid.Column="0"
                Margin="8,0"
                ItemsSource="{Binding ItemsView}"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Single"
                MouseDoubleClick="VerbList_MouseDoubleClick"
                VirtualizingPanel.IsVirtualizing="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="46" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VerbItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="18" Symbol="AppGeneric24" />
                                <Image
                                    Width="20"
                                    Height="20"
                                    Source="{Binding Icon}"
                                    Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedConverter}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.62"
                                    Text="{Binding Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.62"
                                Text="{Binding StatusText}" />

                            <!-- 行尾动作：不堆一排图标按钮（规划 03 §2） -->
                            <ui:Button
                                Grid.Column="3"
                                Margin="4,0,0,0"
                                Padding="6,4"
                                Appearance="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="更多操作"
                                Click="RowMenu_Click">
                                <!-- 前景色直接取自所在行：与行文字同色，浅/深主题及选中态均可见 -->
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                    Opacity="0.72"
                                    Text="…" />
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="查看 / 编辑"
                                            Command="{Binding PlacementTarget.Tag.OpenEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}" />
                                        <MenuItem
                                            Header="启用 / 禁用"
                                            Command="{Binding PlacementTarget.Tag.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}" />
                                        <MenuItem
                                            Header="迁移到当前用户…"
                                            Command="{Binding PlacementTarget.Tag.MigrateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem
                                            Header="删除…"
                                            Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Inspector（规划 03 §2）：同一面板承担新建、查看与编辑 -->
            <Border
                Grid.Column="1"
                Width="340"
                Margin="0,0,8,0"
                Padding="16"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Visibility="{Binding IsInspectorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editor}">
                        <!-- 标题 + 关闭按钮 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding Title}" />
                            <ui:Button
                                Grid.Column="1"
                                Padding="6,4"
                                Appearance="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="关闭 (Esc)"
                                AutomationProperties.Name="关闭面板" />
                        </Grid>

                        <!-- 添加 CLI：发现列表首屏（规划 03 §6） -->
                        <ItemsControl
                            Margin="0,10,0,4"
                            ItemsSource="{Binding Discovered}"
                            Visibility="{Binding ShowDiscovery, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiscoveredCliViewModel}">
                                    <ui:Button
                                        Margin="0,2"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Secondary"
                                        Command="{Binding DataContext.PickDiscoveredCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontSize="13" Text="{Binding DisplayName}" />
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.62"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 受管 CLI 表单（规划 03 §2 简单模式） -->
                        <StackPanel Visibility="{Binding IsManagedForm, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="显示名" />
                            <ui:TextBox FontSize="13" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="可执行文件" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Command="{Binding DataContext.BrowseExecutableCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                    Content="浏览" />
                            </Grid>

                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="终端" />
                            <ComboBox FontSize="13" SelectedIndex="{Binding TerminalIndex}">
                                <ComboBoxItem Content="自动（优先 Windows Terminal）" />
                                <ComboBoxItem Content="Windows Terminal" />
                                <ComboBoxItem Content="经典控制台" />
                            </ComboBox>

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="CLI 退出后保持窗口"
                                FontSize="13"
                                IsChecked="{Binding KeepOpen}" />

                            <Expander
                                Margin="0,10,0,0"
                                Header="高级"
                                FontSize="13">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock FontSize="12" Opacity="0.62" Text="参数（每行一个）" />
                                    <ui:TextBox
                                        MinHeight="52"
                                        AcceptsReturn="True"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,2" FontSize="12" Opacity="0.62" Text="图标（path,index，留空自动）" />
                                    <ui:TextBox
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        Text="{Binding IconSpec, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- 简单项表单 -->
                        <StackPanel Visibility="{Binding IsSimpleForm, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="显示名" />
                            <ui:TextBox FontSize="13" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="命令" />
                            <ui:TextBox
                                MinHeight="52"
                                AcceptsReturn="True"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Text="{Binding RawCommand, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />

                            <TextBlock Margin="0,10,0,2" FontSize="12" Opacity="0.62" Text="图标" />
                            <ui:TextBox
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Text="{Binding IconSpec, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- 只读/可迁移详情 -->
                        <StackPanel DataContext="{Binding Target}" Margin="0,10,0,0">
                            <TextBlock FontSize="12" Opacity="0.62" Text="注册表路径" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Text="{Binding FullKeyPath}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Text="{Binding ReadOnlyReason}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ReadOnlyReason, Converter={StaticResource NullToCollapsedConverter}}" />
                        </StackPanel>

                        <!-- 可迁移项动作（规划 02 §7.4） -->
                        <StackPanel Visibility="{Binding ShowMigrate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="12"
                                Opacity="0.8"
                                Text="此项位于系统范围（HKLM）。迁移后可直接编辑，需要一次管理员确认以删除原项。"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Margin="0,8,0,0"
                                Appearance="Primary"
                                Command="{Binding DataContext.MigrateCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                CommandParameter="{Binding Target}"
                                Content="迁移到当前用户" />
                        </StackPanel>

                        <!-- 旧版遗留项升级 -->
                        <StackPanel Visibility="{Binding ShowUpgrade, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="12"
                                Opacity="0.8"
                                Text="由旧版本创建。升级为受管项后使用新的安全启动链，原命令会备份到操作历史。"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Margin="0,8,0,0"
                                Command="{Binding DataContext.ConvertToManagedCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                Content="升级为受管项" />
                        </StackPanel>

                        <!-- 命令预览（只读） -->
                        <TextBlock Margin="0,12,0,2" FontSize="12" Opacity="0.62" Text="启动方式" />
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            Opacity="0.8"
                            Text="{Binding CommandPreview}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource PaletteRedBrush}"
                            Text="{Binding ValidationError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}" />

                        <!-- 底部动作 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                Content="取消" />
                            <ui:Button
                                Grid.Column="2"
                                Appearance="Primary"
                                Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                Content="保存"
                                Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏（规划 03 §1） -->
        <Grid Grid.Row="3" Margin="16,8,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.62"
                Text="{Binding StatusSummary}" />

            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis" />

            <ui:Button
                Grid.Column="2"
                Margin="0,0,12,0"
                Padding="8,4"
                Appearance="Transparent"
                Command="{Binding UndoLastCommand}"
                Content="撤销"
                FontSize="12"
                IsEnabled="{Binding CanUndo}"
                AutomationProperties.Name="撤销最近一次操作" />

            <CheckBox
                Grid.Column="3"
                Margin="0,0,12,0"
                Content="显示高级项"
                FontSize="12"
                IsChecked="{Binding ShowAdvanced}" />

            <ui:Button
                Grid.Column="4"
                Padding="8,4"
                Appearance="Transparent"
                Click="Settings_Click"
                Content="设置"
                FontSize="12"
                AutomationProperties.Name="设置" />
        </Grid>
    </Grid>
</ui:FluentWindow>
